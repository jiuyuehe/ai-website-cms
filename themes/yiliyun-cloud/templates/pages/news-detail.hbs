{{> partials/page-head}}
<body class="page-detail page-news-detail">
  <a class="skip-link" href="#main">跳至主要内容</a>{{> partials/header}}
  <main id="main"><article><header class="article-header"><div class="container"><nav class="breadcrumbs" aria-label="面包屑"><a href="{{links.home}}">首页</a><span aria-hidden="true">/</span><a href="{{links.news}}">新闻</a><span aria-hidden="true">/</span><span aria-current="page">{{page.item.title}}</span></nav><p class="eyebrow"><time datetime="{{page.item.publishedAt}}">{{date page.item.publishedAt}}</time></p><h1>{{page.item.title}}</h1><p class="lead">{{page.item.summary}}</p></div></header><div class="article-cover"><img src="{{assetUrl page.item.cover.src}}" alt="{{page.item.cover.alt}}" width="1600" height="900" fetchpriority="high"></div><div class="container article-body">{{{renderBlocks page.item.blocks}}}</div></article></main>
  {{> partials/footer}}{{> partials/page-foot}}
