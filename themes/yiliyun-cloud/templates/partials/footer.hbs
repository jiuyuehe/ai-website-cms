<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <a class="footer-brand" href="{{links.home}}"><span class="footer-mark" aria-hidden="true">{{#if site.logo.src}}<img src="{{assetUrl site.logo.src}}" alt="" width="26" height="26">{{else}}☁{{/if}}</span><span>{{site.shortName}}企业网盘</span></a>
      <p class="footer-copy">{{site.description}}</p>
    </div>
    <div class="footer-contact">
      <a href="tel:{{site.contact.phoneHref}}">{{{icon "phone"}}} {{site.contact.phone}}</a>
      <a href="mailto:{{site.contact.email}}">{{{icon "mail"}}} {{site.contact.email}}</a>
      {{#if site.contact.mapUrl}}<a href="{{site.contact.mapUrl}}">{{{icon "map-pin"}}} {{site.contact.address}}</a>{{else}}<span>{{{icon "map-pin"}}} {{site.contact.address}}</span>{{/if}}
    </div>
  </div>
  <div class="container footer-bottom">
    <span>&copy; {{site.year}} {{site.name}} · 企业文件协作与数据管理</span>
    <a href="{{links.faq}}">常见问题</a>
  </div>
</footer>
