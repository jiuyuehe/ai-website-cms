<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="{{links.home}}" aria-label="{{site.name}}首页">
      <span class="brand-mark" aria-hidden="true">{{#if site.logo.src}}<img src="{{assetUrl site.logo.src}}" alt="" width="32" height="32">{{else}}未{{/if}}</span>
      <span class="brand-name">{{site.name}}</span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {{#each site.navLinks}}
        <a class="nav-link{{#if active}} is-active{{/if}}" href="{{href}}"{{#if active}} aria-current="page"{{/if}}>{{label}}</a>
      {{/each}}
      <a class="nav-cta" href="{{links.contact}}">联系我们 {{{icon "arrow-right"}}}</a>
    </nav>
    <details class="mobile-nav">
      <summary aria-label="打开菜单">{{{icon "menu"}}}<span>菜单</span></summary>
      <nav aria-label="移动端主导航">
        {{#each site.navLinks}}
          <a href="{{href}}"{{#if active}} aria-current="page"{{/if}}>{{label}}</a>
        {{/each}}
        <a class="mobile-nav-cta" href="{{links.contact}}">联系我们 {{{icon "arrow-right"}}}</a>
      </nav>
    </details>
  </div>
</header>
