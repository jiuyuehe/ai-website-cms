<article class="product-card">
  <a class="product-card-media" href="{{href}}" aria-label="查看{{title}}">
    <img src="{{assetUrl cover.src}}" alt="{{cover.alt}}" loading="lazy" width="960" height="640">
  </a>
  <div class="product-card-body">
    <div class="card-meta"><p class="eyebrow">产品</p><time datetime="{{updatedAt}}">更新 {{date updatedAt}}</time></div>
    <h3><a href="{{href}}">{{title}}</a></h3>
    <p>{{summary}}</p>
    <a class="text-link" href="{{href}}">查看产品 {{{icon "arrow-right"}}}</a>
  </div>
</article>
