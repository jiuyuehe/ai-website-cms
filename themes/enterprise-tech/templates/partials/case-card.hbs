<article class="case-card">
  <a class="case-card-media" href="{{href}}" aria-label="查看{{title}}">
    <img src="{{assetUrl cover.src}}" alt="{{cover.alt}}" loading="lazy" width="1200" height="800">
  </a>
  <div class="case-card-body">
    <div class="card-meta"><p class="eyebrow">{{customer}}</p><time datetime="{{updatedAt}}">更新 {{date updatedAt}}</time></div>
    <h3><a href="{{href}}">{{title}}</a></h3>
    <p>{{summary}}</p>
    <a class="text-link" href="{{href}}">查看案例 {{{icon "arrow-right"}}}</a>
  </div>
</article>
