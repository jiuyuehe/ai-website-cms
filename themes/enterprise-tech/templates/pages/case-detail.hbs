{{> partials/page-head}}
<body class="page-detail page-case-detail">
  <a class="skip-link" href="#main">跳至主要内容</a>{{> partials/header}}
  <main id="main"><section class="detail-hero"><div class="container"><nav class="breadcrumbs" aria-label="面包屑"><a href="{{links.home}}">首页</a><span aria-hidden="true">/</span><a href="{{links.cases}}">案例</a><span aria-hidden="true">/</span><span aria-current="page">{{page.item.title}}</span></nav><div class="detail-hero-grid"><div><p class="eyebrow">{{page.item.customer}}</p><h1>{{page.item.title}}</h1><p class="lead">{{page.item.summary}}</p></div><figure class="detail-media"><img src="{{assetUrl page.item.cover.src}}" alt="{{page.item.cover.alt}}" width="1200" height="800" fetchpriority="high"></figure></div></div></section><section class="section"><div class="container story-grid"><article><p class="eyebrow">问题</p><h2>知识分散，回答无法保持一致。</h2><p>{{page.item.challenge}}</p></article><article><p class="eyebrow">方案</p><h2>把服务入口和知识流程放在一起。</h2><p>{{page.item.solution}}</p></article></div></section><section class="section section-muted"><div class="container"><div class="section-heading"><p class="eyebrow">结果记录</p><h2>项目结果</h2></div><div class="result-grid">{{#each page.item.results}}<p>{{this}}</p>{{/each}}</div></div></section></main>
  {{> partials/footer}}{{> partials/page-foot}}
