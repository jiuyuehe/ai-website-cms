<style id="theme-tokens">
  :root {
    --surface: {{theme.tokens.light.surface}};
    --surface-elevated: {{theme.tokens.light.surfaceElevated}};
    --surface-muted: {{theme.tokens.light.surfaceMuted}};
    --surface-strong: {{theme.tokens.light.surfaceStrong}};
    --ink: {{theme.tokens.light.ink}};
    --muted: {{theme.tokens.light.muted}};
    --line: {{theme.tokens.light.line}};
    --accent: {{theme.tokens.light.accent}};
    --accent-strong: {{theme.tokens.light.accentStrong}};
    --accent-soft: {{theme.tokens.light.accentSoft}};
    --on-accent: {{theme.tokens.light.onAccent}};
    --focus: {{theme.tokens.light.focus}};
    --shadow: {{theme.tokens.light.shadow}};
    --container: {{theme.tokens.layout.container}};
    --gutter: {{theme.tokens.layout.gutter}};
    --section-space: {{theme.tokens.layout.sectionSpace}};
    --radius-card: {{theme.tokens.layout.radiusCard}};
    --radius-control: {{theme.tokens.layout.radiusControl}};
    --font-display: {{theme.tokens.typography.display}};
    --font-body: {{theme.tokens.typography.body}};
    --font-utility: {{theme.tokens.typography.utility}};
    --ease: {{theme.tokens.motion.ease}};
    --motion-fast: {{theme.tokens.motion.fast}};
    --motion-normal: {{theme.tokens.motion.normal}};
    --motion-slow: {{theme.tokens.motion.slow}};
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --surface: {{theme.tokens.dark.surface}};
      --surface-elevated: {{theme.tokens.dark.surfaceElevated}};
      --surface-muted: {{theme.tokens.dark.surfaceMuted}};
      --surface-strong: {{theme.tokens.dark.surfaceStrong}};
      --ink: {{theme.tokens.dark.ink}};
      --muted: {{theme.tokens.dark.muted}};
      --line: {{theme.tokens.dark.line}};
      --accent: {{theme.tokens.dark.accent}};
      --accent-strong: {{theme.tokens.dark.accentStrong}};
      --accent-soft: {{theme.tokens.dark.accentSoft}};
      --on-accent: {{theme.tokens.dark.onAccent}};
      --focus: {{theme.tokens.dark.focus}};
      --shadow: {{theme.tokens.dark.shadow}};
    }
  }
</style>
