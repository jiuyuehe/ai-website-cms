<article class="dt-product-card product-card">
  <a class="dt-card-media product-card-media" href="{{href}}" aria-label="查看{{title}}">
    <img src="{{assetUrl cover.src}}" alt="{{cover.alt}}" loading="lazy" width="960" height="640">
  </a>
  <div class="dt-card-body product-card-body">
    <div class="dt-card-meta"><span>PRODUCT</span><time datetime="{{updatedAt}}">{{date updatedAt}}</time></div>
    <h3><a href="{{href}}">{{title}}</a></h3>
    <p>{{summary}}</p>
    <a class="dt-text-link" href="{{href}}">查看产品 {{{icon "arrow-up-right"}}}</a>
  </div>
</article>
