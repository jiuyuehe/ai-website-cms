<article class="dt-case-card case-card">
  <a class="dt-card-media case-card-media" href="{{href}}" aria-label="查看{{title}}">
    <img src="{{assetUrl cover.src}}" alt="{{cover.alt}}" loading="lazy" width="1200" height="800">
  </a>
  <div class="dt-card-body case-card-body">
    <div class="dt-card-meta"><span>{{customer}}</span><time datetime="{{updatedAt}}">{{date updatedAt}}</time></div>
    <h3><a href="{{href}}">{{title}}</a></h3>
    <p>{{summary}}</p>
    <a class="dt-text-link" href="{{href}}">查看现场 {{{icon "arrow-up-right"}}}</a>
  </div>
</article>
