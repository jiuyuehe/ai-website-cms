{{> partials/page-head}}
<body class="page-detail page-case-detail">
  <a class="skip-link" href="#main">跳到主要内容</a>
  {{> partials/header}}
  <main id="main"><section class="detail-hero"><div class="dt-container"><nav class="breadcrumbs" aria-label="面包屑"><a href="{{links.home}}">首页</a><span aria-hidden="true">/</span><a href="{{links.cases}}">场景</a><span aria-hidden="true">/</span><span aria-current="page">{{page.item.title}}</span></nav><div class="detail-hero-grid"><div><p class="dt-eyebrow dt-eyebrow-dark">{{page.item.customer}}</p><h1>{{page.item.title}}</h1><p class="lead">{{page.item.summary}}</p></div><figure class="detail-media"><img src="{{assetUrl page.item.cover.src}}" alt="{{page.item.cover.alt}}" width="1200" height="800" fetchpriority="high"></figure></div></div></section><section class="dt-section"><div class="dt-container story-grid"><article><p class="dt-eyebrow dt-eyebrow-dark">CHALLENGE</p><h2>现场需要更快确认</h2><p>{{page.item.challenge}}</p></article><article><p class="dt-eyebrow dt-eyebrow-dark">SOLUTION</p><h2>把观察变成协作</h2><p>{{page.item.solution}}</p></article></div></section><section class="dt-section section-muted"><div class="dt-container"><div class="dt-section-heading"><p class="dt-eyebrow dt-eyebrow-dark">RESULTS</p><h2>项目结果</h2></div><div class="result-grid">{{#each page.item.results}}<p>{{this}}</p>{{/each}}</div></div></section></main>
  {{> partials/footer}}
  {{> partials/page-foot}}
