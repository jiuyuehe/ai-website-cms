{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "status", "title", "summary", "updatedAt", "publishedAt", "cover", "blocks", "seo"],
  "properties": {
    "schemaVersion": {"const": 1}, "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "status": {"enum": ["draft", "published"]}, "title": {"type": "string"}, "summary": {"type": "string"}, "updatedAt": {"type": "string", "format": "date"}, "publishedAt": {"type": "string", "format": "date"}, "cover": {"$ref": "#/$defs/image"}, "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}, "seo": {"$ref": "#/$defs/seo"}
  },
  "$defs": {
    "image": {"type": "object", "additionalProperties": false, "required": ["src", "alt"], "properties": {"src": {"type": "string"}, "alt": {"type": "string"}, "mobileSrc": {"type": "string"}, "caption": {"type": "string"}, "aspectRatio": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "loading": {"enum": ["lazy", "eager"]}}},
    "block": {"oneOf": [{"$ref": "#/$defs/paragraph"}, {"$ref": "#/$defs/heading"}, {"$ref": "#/$defs/list"}, {"$ref": "#/$defs/quote"}, {"$ref": "#/$defs/imageBlock"}, {"$ref": "#/$defs/imageGrid"}, {"$ref": "#/$defs/grid"}, {"$ref": "#/$defs/twoColumn"}, {"$ref": "#/$defs/carousel"}]},
    "layoutItem": {"oneOf": [{"$ref": "#/$defs/paragraph"}, {"$ref": "#/$defs/heading"}, {"$ref": "#/$defs/list"}, {"$ref": "#/$defs/quote"}, {"$ref": "#/$defs/imageBlock"}, {"$ref": "#/$defs/card"}]},
    "paragraph": {"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "paragraph"}, "text": {"type": "string"}}},
    "heading": {"type": "object", "additionalProperties": false, "required": ["type", "level", "text"], "properties": {"type": {"const": "heading"}, "level": {"enum": [2, 3, 4]}, "text": {"type": "string"}}},
    "list": {"type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": {"type": {"const": "list"}, "ordered": {"type": "boolean"}, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "quote": {"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "quote"}, "text": {"type": "string"}, "attribution": {"type": "string"}}},
    "imageBlock": {"type": "object", "additionalProperties": false, "required": ["type", "src", "alt"], "properties": {"type": {"const": "image"}, "src": {"type": "string"}, "alt": {"type": "string"}, "mobileSrc": {"type": "string"}, "caption": {"type": "string"}, "aspectRatio": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}, "loading": {"enum": ["lazy", "eager"]}}},
    "card": {"type": "object", "additionalProperties": false, "required": ["type", "title"], "properties": {"type": {"const": "card"}, "title": {"type": "string"}, "body": {"type": "string"}, "badge": {"type": "string"}, "image": {"$ref": "#/$defs/image"}, "items": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}}, "link": {"type": "object", "additionalProperties": false, "required": ["label", "route"], "properties": {"label": {"type": "string"}, "route": {"type": "string"}, "external": {"type": "boolean"}}}}},
    "imageGrid": {"type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": {"type": {"const": "image-grid"}, "cols": {"type": "integer", "minimum": 2, "maximum": 4}, "items": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/image"}}}},
    "grid": {"type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": {"type": {"const": "grid"}, "cols": {"type": "integer", "minimum": 2, "maximum": 4}, "items": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/layoutItem"}}}},
    "twoColumn": {"type": "object", "additionalProperties": false, "required": ["type", "columns"], "properties": {"type": {"const": "two-column"}, "layout": {"enum": ["text-media", "media-text"]}, "columns": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layoutItem"}}}}},
    "carousel": {"type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": {"type": {"const": "carousel"}, "items": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"$ref": "#/$defs/carouselItem"}}, "autoplay": {"type": "integer", "minimum": 2000, "maximum": 12000}, "showArrows": {"type": "boolean"}, "showDots": {"type": "boolean"}}},
    "carouselItem": {"type": "object", "additionalProperties": false, "required": ["image"], "properties": {"image": {"$ref": "#/$defs/image"}, "title": {"type": "string"}, "body": {"type": "string"}, "caption": {"type": "string"}}},
    "seo": {"type": "object", "additionalProperties": false, "required": ["title", "description", "keywords"], "properties": {"title": {"type": "string"}, "description": {"type": "string"}, "keywords": {"type": "array", "items": {"type": "string"}}, "image": {"type": "string"}}}
  }
}
