{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "status", "title", "summary", "updatedAt", "cover", "content", "seo"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"enum": ["draft", "published"]},
    "title": {"type": "string", "minLength": 2},
    "summary": {"type": "string", "minLength": 10},
    "updatedAt": {"type": "string", "format": "date"},
    "cover": {"$ref": "#/$defs/image"},
    "mobileCover": {"$ref": "#/$defs/image"},
    "gallery": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/image"}
    },
    "purchaseAction": {"$ref": "#/$defs/action"},
    "secondaryAction": {"$ref": "#/$defs/action"},
    "specifications": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/specification"}
    },
    "badges": {
      "type": "array",
      "maxItems": 6,
      "items": {"type": "string", "minLength": 1, "maxLength": 60}
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intro", "features", "advantages", "scenarios", "faq", "downloads"],
      "properties": {
        "intro": {"type": "string", "minLength": 10},
        "features": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/item"}},
        "advantages": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/item"}},
        "scenarios": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/item"}},
        "faq": {"type": "array", "items": {"$ref": "#/$defs/faq"}},
        "downloads": {"type": "array", "items": {"type": "string"}}
      }
    },
    "seo": {"$ref": "#/$defs/seo"}
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": {"type": "string"},
        "alt": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "route"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "route": {"type": "string", "minLength": 1}
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": {"type": "string"},
        "body": {"type": "string"},
        "icon": {"type": "string"}
      }
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": {"type": "string"},
        "answer": {"type": "string"}
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "keywords"],
      "properties": {
        "title": {"type": "string", "minLength": 5},
        "description": {"type": "string", "minLength": 10},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "image": {"type": "string"}
      }
    }
  }
}
