{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "intro"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["draft", "published"]},
    "intro": {"$ref": "#/$defs/sectionHeading"},
    "plans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/pricingPlan"}
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/pricingItem"}
    },
    "custom": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/customItem"}
    },
    "promotions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/promotionItem"}
    },
    "note": {"type": "string", "maxLength": 400},
    "seo": {"$ref": "#/$defs/seo"}
  },
  "$defs": {
    "sectionHeading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "eyebrow": {"type": "string", "maxLength": 80},
        "title": {"type": "string", "minLength": 2, "maxLength": 200},
        "body": {"type": "string", "minLength": 2, "maxLength": 400}
      }
    },
    "pricingPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fit", "price", "unit", "features"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 40},
        "badge": {"type": "string", "maxLength": 20},
        "fit": {"type": "string", "maxLength": 120},
        "price": {"type": "string", "minLength": 1, "maxLength": 20},
        "unit": {"type": "string", "maxLength": 40},
        "features": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1}},
        "ctaLabel": {"type": "string", "maxLength": 40},
        "highlight": {"type": "boolean"}
      }
    },
    "pricingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "price"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "summary": {"type": "string", "maxLength": 200},
        "price": {"type": "string", "minLength": 1, "maxLength": 20},
        "unit": {"type": "string", "maxLength": 40},
        "note": {"type": "string", "maxLength": 200}
      }
    },
    "customItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "body": {"type": "string", "minLength": 1, "maxLength": 300},
        "price": {"type": "string", "maxLength": 40}
      }
    },
    "promotionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "price"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "body": {"type": "string", "minLength": 1, "maxLength": 300},
        "badge": {"type": "string", "maxLength": 20},
        "price": {"type": "string", "minLength": 1, "maxLength": 20},
        "unit": {"type": "string", "maxLength": 40},
        "validUntil": {"type": "string", "maxLength": 40}
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "keywords"],
      "properties": {
        "title": {"type": "string", "minLength": 5, "maxLength": 120},
        "description": {"type": "string", "minLength": 10, "maxLength": 320},
        "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "image": {"type": "string"}
      }
    }
  }
}
